<Window x:Class="SonarMidiController.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SteelSeries Sonar MIDI Controller"
        Icon="Assets/MidiToSonar.ico"
        Width="1180"
        Height="760"
        MinWidth="1080"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="#181B20"
        Foreground="#F3F4F6">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="TickFrequency" Value="1" />
            <Setter Property="IsSnapToTickEnabled" Value="False" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#303640" />
            <Setter Property="Foreground" Value="#F3F4F6" />
            <Setter Property="BorderBrush" Value="#4B5563" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="4,2" />
        </Style>
        <Style TargetType="ToggleButton">
            <Setter Property="Background" Value="#303640" />
            <Setter Property="Foreground" Value="#F3F4F6" />
            <Setter Property="BorderBrush" Value="#4B5563" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="5,0" />
        </Style>
        <Style x:Key="ColumnHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9CA3AF" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
        <Style x:Key="MappingText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9CA3AF" />
            <Setter Property="Margin" Value="8,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </Window.Resources>

    <Grid Margin="28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="180" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="SteelSeries Sonar MIDI Controller"
                           FontSize="24"
                           FontWeight="SemiBold" />
                <TextBlock Text="Direct local control of the Sonar classic mixer"
                           Margin="0,5,0,0"
                           Foreground="#9CA3AF" />
            </StackPanel>

            <Button Grid.Column="1"
                    Content="Settings"
                    Width="124"
                    Height="36"
                    Margin="24,0"
                    VerticalAlignment="Center"
                    Click="SettingsButton_Click" />

            <TextBlock x:Name="CreditsText"
                       Grid.Column="2"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Top"
                       Foreground="#9CA3AF"
                       FontSize="13"
                       FontWeight="SemiBold" />
        </Grid>

        <Border Grid.Row="1"
                Margin="0,18,0,14"
                Padding="12,9"
                Background="#22262D"
                CornerRadius="6">
            <DockPanel>
                <Ellipse x:Name="ConnectionDot"
                         Width="10"
                         Height="10"
                         Fill="#6B7280"
                         Margin="0,0,8,0" />
                <TextBlock x:Name="ConnectionText"
                           Text="Sonar: CONNECTING"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="LastErrorText"
                           Margin="18,0,0,0"
                           Foreground="#FCA5A5"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="92" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="62" />
                <ColumnDefinition Width="102" />
                <ColumnDefinition Width="58" />
                <ColumnDefinition Width="84" />
                <ColumnDefinition Width="205" />
                <ColumnDefinition Width="84" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="76" />
                <RowDefinition Height="76" />
                <RowDefinition Height="76" />
                <RowDefinition Height="76" />
                <RowDefinition Height="76" />
                <RowDefinition Height="76" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="CHANNEL" Style="{StaticResource ColumnHeader}" />
            <TextBlock Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Text="VOLUME" Style="{StaticResource ColumnHeader}" />
            <TextBlock Grid.Row="0" Grid.Column="3" Text="SONAR MUTE" Style="{StaticResource ColumnHeader}" />
            <TextBlock Grid.Row="0" Grid.Column="4" Text="TYPE" Style="{StaticResource ColumnHeader}" />
            <TextBlock Grid.Row="0" Grid.Column="5" Text="MIDI" Style="{StaticResource ColumnHeader}" />
            <TextBlock Grid.Row="0" Grid.Column="6" Text="MAPPING" Style="{StaticResource ColumnHeader}" />
            <TextBlock Grid.Row="0" Grid.Column="7" Text="RESET" Style="{StaticResource ColumnHeader}" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="MASTER" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <Slider x:Name="MasterSlider" Grid.Row="1" Grid.Column="1" Tag="Master" ValueChanged="VolumeSlider_ValueChanged" />
            <TextBlock x:Name="MasterValue" Grid.Row="1" Grid.Column="2" Text="--%" HorizontalAlignment="Center" />
            <ToggleButton x:Name="MasterMute" Grid.Row="1" Grid.Column="3" Tag="Master" Content="MUTE" Click="MuteButton_Click" />
            <Grid Grid.Row="1" Grid.Column="4" Grid.ColumnSpan="4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="58" /><ColumnDefinition Width="84" /><ColumnDefinition Width="205" /><ColumnDefinition Width="84" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="VOL" HorizontalAlignment="Center" Foreground="#9CA3AF" />
                <Button Grid.Row="0" Grid.Column="1" Tag="Master" Content="Learn" Click="LearnVolumeButton_Click" />
                <TextBlock x:Name="MasterVolumeMapping" Grid.Row="0" Grid.Column="2" Text="Not mapped" Style="{StaticResource MappingText}" />
                <Button Grid.Row="0" Grid.Column="3" Tag="Master" Content="Reset" Click="ResetVolumeMappingButton_Click" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="MUTE" HorizontalAlignment="Center" Foreground="#9CA3AF" />
                <Button Grid.Row="1" Grid.Column="1" Tag="Master" Content="Learn" Click="LearnMuteButton_Click" />
                <TextBlock x:Name="MasterMuteMapping" Grid.Row="1" Grid.Column="2" Text="Not mapped" Style="{StaticResource MappingText}" />
                <Button Grid.Row="1" Grid.Column="3" Tag="Master" Content="Reset" Click="ResetMuteMappingButton_Click" />
            </Grid>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="GAME" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <Slider x:Name="GameSlider" Grid.Row="2" Grid.Column="1" Tag="Game" ValueChanged="VolumeSlider_ValueChanged" />
            <TextBlock x:Name="GameValue" Grid.Row="2" Grid.Column="2" Text="--%" HorizontalAlignment="Center" />
            <ToggleButton x:Name="GameMute" Grid.Row="2" Grid.Column="3" Tag="Game" Content="MUTE" Click="MuteButton_Click" />
            <Grid Grid.Row="2" Grid.Column="4" Grid.ColumnSpan="4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="58" /><ColumnDefinition Width="84" /><ColumnDefinition Width="205" /><ColumnDefinition Width="84" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="VOL" HorizontalAlignment="Center" Foreground="#9CA3AF" />
                <Button Grid.Row="0" Grid.Column="1" Tag="Game" Content="Learn" Click="LearnVolumeButton_Click" />
                <TextBlock x:Name="GameVolumeMapping" Grid.Row="0" Grid.Column="2" Text="Not mapped" Style="{StaticResource MappingText}" />
                <Button Grid.Row="0" Grid.Column="3" Tag="Game" Content="Reset" Click="ResetVolumeMappingButton_Click" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="MUTE" HorizontalAlignment="Center" Foreground="#9CA3AF" />
                <Button Grid.Row="1" Grid.Column="1" Tag="Game" Content="Learn" Click="LearnMuteButton_Click" />
                <TextBlock x:Name="GameMuteMapping" Grid.Row="1" Grid.Column="2" Text="Not mapped" Style="{StaticResource MappingText}" />
                <Button Grid.Row="1" Grid.Column="3" Tag="Game" Content="Reset" Click="ResetMuteMappingButton_Click" />
            </Grid>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="CHAT" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <Slider x:Name="ChatSlider" Grid.Row="3" Grid.Column="1" Tag="Chat" ValueChanged="VolumeSlider_ValueChanged" />
            <TextBlock x:Name="ChatValue" Grid.Row="3" Grid.Column="2" Text="--%" HorizontalAlignment="Center" />
            <ToggleButton x:Name="ChatMute" Grid.Row="3" Grid.Column="3" Tag="Chat" Content="MUTE" Click="MuteButton_Click" />
            <Grid Grid.Row="3" Grid.Column="4" Grid.ColumnSpan="4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="58" /><ColumnDefinition Width="84" /><ColumnDefinition Width="205" /><ColumnDefinition Width="84" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="VOL" HorizontalAlignment="Center" Foreground="#9CA3AF" />
                <Button Grid.Row="0" Grid.Column="1" Tag="Chat" Content="Learn" Click="LearnVolumeButton_Click" />
                <TextBlock x:Name="ChatVolumeMapping" Grid.Row="0" Grid.Column="2" Text="Not mapped" Style="{StaticResource MappingText}" />
                <Button Grid.Row="0" Grid.Column="3" Tag="Chat" Content="Reset" Click="ResetVolumeMappingButton_Click" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="MUTE" HorizontalAlignment="Center" Foreground="#9CA3AF" />
                <Button Grid.Row="1" Grid.Column="1" Tag="Chat" Content="Learn" Click="LearnMuteButton_Click" />
                <TextBlock x:Name="ChatMuteMapping" Grid.Row="1" Grid.Column="2" Text="Not mapped" Style="{StaticResource MappingText}" />
                <Button Grid.Row="1" Grid.Column="3" Tag="Chat" Content="Reset" Click="ResetMuteMappingButton_Click" />
            </Grid>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="MEDIA" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <Slider x:Name="MediaSlider" Grid.Row="4" Grid.Column="1" Tag="Media" ValueChanged="VolumeSlider_ValueChanged" />
            <TextBlock x:Name="MediaValue" Grid.Row="4" Grid.Column="2" Text="--%" HorizontalAlignment="Center" />
            <ToggleButton x:Name="MediaMute" Grid.Row="4" Grid.Column="3" Tag="Media" Content="MUTE" Click="MuteButton_Click" />
            <Grid Grid.Row="4" Grid.Column="4" Grid.ColumnSpan="4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="58" /><ColumnDefinition Width="84" /><ColumnDefinition Width="205" /><ColumnDefinition Width="84" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="VOL" HorizontalAlignment="Center" Foreground="#9CA3AF" />
                <Button Grid.Row="0" Grid.Column="1" Tag="Media" Content="Learn" Click="LearnVolumeButton_Click" />
                <TextBlock x:Name="MediaVolumeMapping" Grid.Row="0" Grid.Column="2" Text="Not mapped" Style="{StaticResource MappingText}" />
                <Button Grid.Row="0" Grid.Column="3" Tag="Media" Content="Reset" Click="ResetVolumeMappingButton_Click" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="MUTE" HorizontalAlignment="Center" Foreground="#9CA3AF" />
                <Button Grid.Row="1" Grid.Column="1" Tag="Media" Content="Learn" Click="LearnMuteButton_Click" />
                <TextBlock x:Name="MediaMuteMapping" Grid.Row="1" Grid.Column="2" Text="Not mapped" Style="{StaticResource MappingText}" />
                <Button Grid.Row="1" Grid.Column="3" Tag="Media" Content="Reset" Click="ResetMuteMappingButton_Click" />
            </Grid>

            <TextBlock Grid.Row="5" Grid.Column="0" Text="AUX" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <Slider x:Name="AuxSlider" Grid.Row="5" Grid.Column="1" Tag="Aux" ValueChanged="VolumeSlider_ValueChanged" />
            <TextBlock x:Name="AuxValue" Grid.Row="5" Grid.Column="2" Text="--%" HorizontalAlignment="Center" />
            <ToggleButton x:Name="AuxMute" Grid.Row="5" Grid.Column="3" Tag="Aux" Content="MUTE" Click="MuteButton_Click" />
            <Grid Grid.Row="5" Grid.Column="4" Grid.ColumnSpan="4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="58" /><ColumnDefinition Width="84" /><ColumnDefinition Width="205" /><ColumnDefinition Width="84" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="VOL" HorizontalAlignment="Center" Foreground="#9CA3AF" />
                <Button Grid.Row="0" Grid.Column="1" Tag="Aux" Content="Learn" Click="LearnVolumeButton_Click" />
                <TextBlock x:Name="AuxVolumeMapping" Grid.Row="0" Grid.Column="2" Text="Not mapped" Style="{StaticResource MappingText}" />
                <Button Grid.Row="0" Grid.Column="3" Tag="Aux" Content="Reset" Click="ResetVolumeMappingButton_Click" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="MUTE" HorizontalAlignment="Center" Foreground="#9CA3AF" />
                <Button Grid.Row="1" Grid.Column="1" Tag="Aux" Content="Learn" Click="LearnMuteButton_Click" />
                <TextBlock x:Name="AuxMuteMapping" Grid.Row="1" Grid.Column="2" Text="Not mapped" Style="{StaticResource MappingText}" />
                <Button Grid.Row="1" Grid.Column="3" Tag="Aux" Content="Reset" Click="ResetMuteMappingButton_Click" />
            </Grid>

            <TextBlock Grid.Row="6" Grid.Column="0" Text="MIC" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <Slider x:Name="MicSlider" Grid.Row="6" Grid.Column="1" Tag="Mic" ValueChanged="VolumeSlider_ValueChanged" />
            <TextBlock x:Name="MicValue" Grid.Row="6" Grid.Column="2" Text="--%" HorizontalAlignment="Center" />
            <ToggleButton x:Name="MicMute" Grid.Row="6" Grid.Column="3" Tag="Mic" Content="MUTE" Click="MuteButton_Click" />
            <Grid Grid.Row="6" Grid.Column="4" Grid.ColumnSpan="4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="58" /><ColumnDefinition Width="84" /><ColumnDefinition Width="205" /><ColumnDefinition Width="84" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="VOL" HorizontalAlignment="Center" Foreground="#9CA3AF" />
                <Button Grid.Row="0" Grid.Column="1" Tag="Mic" Content="Learn" Click="LearnVolumeButton_Click" />
                <TextBlock x:Name="MicVolumeMapping" Grid.Row="0" Grid.Column="2" Text="Not mapped" Style="{StaticResource MappingText}" />
                <Button Grid.Row="0" Grid.Column="3" Tag="Mic" Content="Reset" Click="ResetVolumeMappingButton_Click" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="MUTE" HorizontalAlignment="Center" Foreground="#9CA3AF" />
                <Button Grid.Row="1" Grid.Column="1" Tag="Mic" Content="Learn" Click="LearnMuteButton_Click" />
                <TextBlock x:Name="MicMuteMapping" Grid.Row="1" Grid.Column="2" Text="Not mapped" Style="{StaticResource MappingText}" />
                <Button Grid.Row="1" Grid.Column="3" Tag="Mic" Content="Reset" Click="ResetMuteMappingButton_Click" />
            </Grid>
        </Grid>

        <Border Grid.Row="3"
                Margin="0,14,0,0"
                Padding="12,9"
                Background="#22262D"
                CornerRadius="6">
            <DockPanel>
                <TextBlock Text="MIDI:"
                           FontWeight="SemiBold"
                           Margin="0,0,8,0" />
                <TextBlock x:Name="MidiStatusText"
                           Text="Starting..."
                           Foreground="#9CA3AF" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
