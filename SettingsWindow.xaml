<Window x:Class="SonarMidiController.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MIDI to Sonar Settings"
        Icon="Assets/MidiToSonar.ico"
        Width="470"
        Height="540"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#181B20"
        Foreground="#F3F4F6">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#303640" />
            <Setter Property="Foreground" Value="#F3F4F6" />
            <Setter Property="BorderBrush" Value="#4B5563" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="MinWidth" Value="92" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#F3F4F6" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Height" Value="34" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="58" />
                            </Grid.ColumnDefinitions>

                            <ContentPresenter VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />

                            <Border x:Name="SwitchTrack"
                                    Grid.Column="1"
                                    Width="54"
                                    Height="28"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Background="#3A414C"
                                    BorderBrush="#66717D8C"
                                    BorderThickness="1"
                                    CornerRadius="14">
                                <Grid ClipToBounds="True">
                                    <TextBlock x:Name="StateText"
                                               Text="OFF"
                                               Margin="0,0,6,0"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Foreground="#CBD5E1"
                                               FontSize="8"
                                               FontWeight="Bold" />
                                    <Ellipse Width="22"
                                             Height="22"
                                             Margin="3,0,0,0"
                                             HorizontalAlignment="Left"
                                             VerticalAlignment="Center"
                                             Fill="#F8FAFC">
                                        <Ellipse.RenderTransform>
                                            <TranslateTransform x:Name="SwitchKnobTransform" />
                                        </Ellipse.RenderTransform>
                                        <Ellipse.Effect>
                                            <DropShadowEffect Color="#000000"
                                                              BlurRadius="5"
                                                              ShadowDepth="1"
                                                              Opacity="0.5" />
                                        </Ellipse.Effect>
                                    </Ellipse>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="#93C5FD" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Background" Value="#34C759" />
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="#68E37D" />
                                <Setter TargetName="StateText" Property="Text" Value="ON" />
                                <Setter TargetName="StateText" Property="HorizontalAlignment" Value="Left" />
                                <Setter TargetName="StateText" Property="Margin" Value="7,0,0,0" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SwitchKnobTransform"
                                                             Storyboard.TargetProperty="X"
                                                             To="26"
                                                             Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SwitchKnobTransform"
                                                             Storyboard.TargetProperty="X"
                                                             To="0"
                                                             Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Settings"
                       FontSize="22"
                       FontWeight="SemiBold" />
            <TextBlock Text="Startup, widget and local data options"
                       Margin="0,4,0,0"
                       Foreground="#9CA3AF" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,24,0,18">
            <CheckBox x:Name="StartWithWindowsCheckBox"
                      Content="Start with Windows" />
            <CheckBox x:Name="StartMinimizedCheckBox"
                      Content="Start minimized" />
            <CheckBox x:Name="ShowWidgetCheckBox"
                      Content="Overlay widget" />
            <CheckBox x:Name="LockWidgetCheckBox">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72E;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="16"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center" />
                    <TextBlock Text="Lock overlay (click-through)"
                               VerticalAlignment="Center" />
                </StackPanel>
            </CheckBox>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Widget background opacity"
                           Foreground="#D1D5DB" />
                <TextBlock x:Name="BackgroundOpacityValueText"
                           Grid.Column="1"
                           Foreground="#9CA3AF" />
                <Slider x:Name="BackgroundOpacitySlider"
                        Grid.Row="1"
                        Grid.ColumnSpan="2"
                        Minimum="0"
                        Maximum="100"
                        Margin="0,8,0,0"
                        ValueChanged="OpacitySlider_ValueChanged" />
            </Grid>

            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="MUTE buttons opacity"
                           Foreground="#D1D5DB" />
                <TextBlock x:Name="MuteOpacityValueText"
                           Grid.Column="1"
                           Foreground="#9CA3AF" />
                <Slider x:Name="MuteOpacitySlider"
                        Grid.Row="1"
                        Grid.ColumnSpan="2"
                        Minimum="0"
                        Maximum="100"
                        Margin="0,8,0,0"
                        ValueChanged="OpacitySlider_ValueChanged" />
            </Grid>
            <Button Content="Open folder"
                    HorizontalAlignment="Left"
                    Click="OpenFolderButton_Click" />
        </StackPanel>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Cancel"
                    Margin="0,0,10,0"
                    IsCancel="True" />
            <Button Content="Save"
                    Background="#2563EB"
                    BorderBrush="#3B82F6"
                    IsDefault="True"
                    Click="SaveButton_Click" />
        </StackPanel>
    </Grid>
</Window>
