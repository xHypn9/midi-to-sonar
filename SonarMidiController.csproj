<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>SteelSeriesSonarMidiController</AssemblyName>
    <RootNamespace>SonarMidiController.App</RootNamespace>
    <Version Condition="'$(DiagnosticBuild)' != 'true'">1.3.5</Version>
    <Version Condition="'$(DiagnosticBuild)' == 'true'">1.3.5-diagnostic.1</Version>
    <AssemblyVersion>1.3.5.0</AssemblyVersion>
    <FileVersion Condition="'$(DiagnosticBuild)' != 'true'">1.3.5.0</FileVersion>
    <FileVersion Condition="'$(DiagnosticBuild)' == 'true'">1.3.5.1</FileVersion>
    <DefineConstants Condition="'$(DiagnosticBuild)' == 'true'">$(DefineConstants);DIAGNOSTIC_BUILD</DefineConstants>
    <ApplicationIcon>Assets\MidiToSonar.ico</ApplicationIcon>
    <DefaultItemExcludes>$(DefaultItemExcludes);src\**;tests\**;tools\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\MidiToSonar.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="src\SonarController.Core\SonarController.Core.csproj" />
    <ProjectReference Include="src\SonarController.Midi\SonarController.Midi.csproj" />
  </ItemGroup>
</Project>
